# PostgreSQL bağlantısı (ZORUNLU)
# Format: postgresql://KULLANICI:SIFRE@HOST:PORT/VERITABANI
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sustainable

# Barındırılan (Supabase / Neon / Render) DB için SSL gerekiyorsa "true" yapın
DATABASE_SSL=false

# NextAuth oturum şifreleme anahtarı (ZORUNLU)
# Üretmek için:  openssl rand -base64 32
NEXTAUTH_SECRET=buraya-uzun-rastgele-bir-deger-yazin
NEXTAUTH_URL=http://localhost:3000

# Opsiyonel sosyal giriş (kullanmıyorsanız boş bırakabilirsiniz)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
